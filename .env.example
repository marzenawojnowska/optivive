# Stripe credentials are supplied by the Replit Stripe connector.
# Do not paste Stripe secret keys into this file.

# Base monthly EUR price IDs created by scripts/src/seed-billing-products.ts
BILLING_STRIPE_STARTER_PRICE_ID=
BILLING_STRIPE_GROWTH_PRICE_ID=
BILLING_STRIPE_PRO_PRICE_ID=

# Backend-only Pro add-on amounts, in EUR cents.
# Set these before running the seed script to create the add-on prices.
BILLING_PRO_WORKSPACE_EUR_CENTS=
BILLING_PRO_ARTICLE_EUR_CENTS=
BILLING_PRO_SEAT_EUR_CENTS=

# Backend-only Pro add-on price IDs created by the seed script.
BILLING_STRIPE_PRO_WORKSPACE_PRICE_ID=
BILLING_STRIPE_PRO_ARTICLE_PRICE_ID=
BILLING_STRIPE_PRO_SEAT_PRICE_ID=