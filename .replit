[objectStorage]
defaultBucketID = "replit-objstore-949d2640-ca56-4b30-a682-71f4522dc8f6"

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18325
externalPort = 9000

[[workflows.workflow]]
name = "seo-studio-e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/seo-studio run e2e"

[workflows.workflow.metadata]
isValidation = true
