modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-server-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-server-typecheck-clean-db"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "seo-studio-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "release-build"
[[workflows.workflow.tasks]]
task = "workflow.run"
args = "seo-studio-e2e"

[[workflows.workflow]]
name = "api-server-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "DATABASE_ENV=test pnpm --filter @workspace/api-server run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-server-typecheck-clean-db"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck:api:clean-db"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "seo-studio-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/seo-studio run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "release-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run build && pnpm run check:artifact-asset-prefixes"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"


[userenv]

[userenv.shared]
EDITOR_EMAIL_ALLOWLIST = ""

[userenv.development]
GOOGLE_REDIRECT_URI = "https://836310a7-52ae-4992-9aa8-bdf12458bce7-00-3877uacv5ho5o.kira.replit.dev/api/v2/google/oauth/callback"
BILLING_STRIPE_GROWTH_PRICE_ID = "price_1UID9wB2zVNxxV4I6kKjdONc"
BILLING_PRO_ARTICLE_EUR_CENTS = "500"
BILLING_PRO_SEAT_EUR_CENTS = "1000"
BILLING_PRO_WORKSPACE_EUR_CENTS = "1000"
